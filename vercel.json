{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 7 * * *"
    }
  ],
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/ai/*.ts": {
      "maxDuration": 30
    }
  }
}
