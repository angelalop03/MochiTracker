# Copia este archivo como .env.local y rellena los valores.
# Nunca subas .env.local a git.

# --- Navegador (el prefijo VITE_ hace que lleguen al cliente: solo valores públicos) ---

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=
# Supabase > Project Settings > API > clave "anon" / "publishable".
# Es pública por diseño: lo que protege los datos es Row Level Security.
VITE_SUPABASE_ANON_KEY=
# Clave pública de notificaciones. Genera el par con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Solo servidor: configúralas en Vercel. Nunca con prefijo VITE_ ---

# Supabase > Project Settings > API > clave "service_role". Se salta RLS: máximo cuidado.
SUPABASE_SERVICE_ROLE_KEY=
# La clave privada del par de notificaciones
VAPID_PRIVATE_KEY=
# Un contacto para los servicios de push, por ejemplo mailto:hola@tudominio.es
VAPID_SUBJECT=
# Brevo > SMTP y API > Claves API
BREVO_API_KEY=
# Remitente verificado en Brevo. Mejor un correo creado solo para la app
BREVO_SENDER_EMAIL=
# URL pública de la web, sin barra final
APP_URL=
# Secreto del cron. Genera uno largo y aleatorio. Vercel lo envía solo al llamar al cron
CRON_SECRET=
# Secreto para firmar los enlaces de baja. Genera otro distinto
UNSUBSCRIBE_SECRET=

# ---------------------------------------------------------------- IA en la nube
# Solo en el servidor (Vercel). NUNCA con prefijo VITE_: la clave no debe llegar al navegador.
# Groq, plan gratuito sin tarjeta: https://console.groq.com/keys
# Activa "Zero Data Retention" en https://console.groq.com/settings/data-controls
AI_API_KEY=
# Opcionales: cualquier proveedor compatible con la API de chat de OpenAI
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# AI_PROVIDER=mock   # respuestas simuladas, sin conexión
# Límites gratuitos por usuaria y día, y topes globales por debajo del plan del proveedor
# AI_CHAT_DAILY=5
# AI_ADVICE_DAILY=1
# AI_GLOBAL_REQUESTS_DAILY=900
# AI_GLOBAL_TOKENS_DAILY=180000
