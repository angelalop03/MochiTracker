# Copia este archivo como .env.local y rellena los valores.
# Nunca subas .env.local a git.

# --- Navegador (el prefijo VITE_ hace que lleguen al cliente: solo valores públicos) ---

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=
# Supabase > Project Settings > API > clave "anon" / "publishable".
# Es pública por diseño: lo que protege los datos es Row Level Security.
VITE_SUPABASE_ANON_KEY=
# Clave pública de notificaciones. Genera el par con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Solo servidor: configúralas en Vercel. Nunca con prefijo VITE_ ---

# Supabase > Project Settings > API > clave "service_role". Se salta RLS: máximo cuidado.
SUPABASE_SERVICE_ROLE_KEY=
# La clave privada del par de notificaciones
VAPID_PRIVATE_KEY=
# Un contacto para los servicios de push, por ejemplo mailto:hola@tudominio.es
VAPID_SUBJECT=
# Brevo > SMTP y API > Claves API
BREVO_API_KEY=
# Remitente verificado en Brevo. Mejor un correo creado solo para la app
BREVO_SENDER_EMAIL=
# URL pública de la web, sin barra final
APP_URL=
# Secreto del cron. Genera uno largo y aleatorio. Vercel lo envía solo al llamar al cron
CRON_SECRET=
# Secreto para firmar los enlaces de baja. Genera otro distinto
UNSUBSCRIBE_SECRET=
